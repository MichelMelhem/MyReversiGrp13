@startuml
skinparam actorStyle hollow
left to right direction

object ":Player" as Player
object ":Game" as Game
object ":Board" as Board

Player --> Game : 1: playMove(x, y)
Game --> Board : 1.1: validate(x, y)
Board --> Game : 1.2 [invalide]: rejectMove()
Game --> Player : 1.3: showError("Coup invalide")
@enduml
