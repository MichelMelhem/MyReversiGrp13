@startuml deployment_diagram
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
title MyReversi - Deployment Diagram (section 3.2.1 client/server)\nPhase 2 - Group 13

node "Player 1 device" as pc1 <<device>> {
  node "Web browser" as b1 <<execution environment>> {
    artifact "index.html / game.html\nhistory.html / replay.html" as ui1
    artifact "common.js, game.js ..." as js1
  }
}

node "Player 2 device\n(online games only)" as pc2 <<device>> {
  node "Web browser" as b2 <<execution environment>> {
    artifact "same client files" as ui2
  }
}

node "MyReversi server" as srv <<device>> {
  node "Django 6.1 + Django REST framework" as dj <<execution environment>> {
    component "api (GameAPI, GameService)" as api
    component "game (domain rules)" as game
    component "database (models)" as dbapp
  }
  database "SQLite\n(db.sqlite3)" as db
}

pc1 -- srv : HTTP(S) / JSON\npolled every 1.5 s
pc2 -- srv : HTTP(S) / JSON\npolled every 1.5 s
api ..> game
api ..> dbapp
dbapp -- db : Django ORM
@enduml
